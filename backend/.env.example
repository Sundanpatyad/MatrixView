ENVIRONMENT=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dockx?retryWrites=true&w=majority
# true = RAM-only MongoDB; all data is lost on every server restart. Never enable in production.
USE_MEMORY_DB=false
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DESKTOP=90d
REFRESH_TOKEN_TTL_REMEMBER=90d
REFRESH_TOKEN_TTL_SESSION=1d
CORS_ORIGIN=http://localhost:5175,http://localhost:5173,https://admin-dockx.vercel.app,https://matrix-view.vercel.app
SEED_EMAIL=riya@acme.dev
SEED_PASSWORD=Password123
APP_URL=https://admin-dockx.vercel.app
WEB_APP_ORIGINS=https://admin-dockx.vercel.app,https://matrix-view.vercel.app,http://localhost:5175
# Optional — without SMTP, invite links are logged + returned in the API
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Cloudflare R2 (S3-compatible). When set, uploads go to R2; otherwise local /uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# Optional — defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Cloudinary — chat images only; user/task images use R2
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google OAuth
# Desktop DockX app: "Desktop" / installed client. Loopback is http://127.0.0.1:PORT/
# Web (Vercel): "Web application" client. Do NOT set GOOGLE_REDIRECT_URI to http://localhost —
# that sends the browser to a local page after Google sign-in.
#   GOOGLE_REDIRECT_URI=https://YOUR_API_HOST/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS / Android clients — used to verify native ID tokens
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=569448299007-djn2v1re676r3rjcqm84fbrjraddbdnp.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://matrixview-569448299007.asia-south1.run.app/api/auth/google/callback
# Firebase Cloud Messaging (Android push). Keys from the Admin SDK service account.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
