# Base URL of the DockX backend (REST + Socket.IO share this origin).
#
# In development you can leave this as localhost: on a physical device or
# emulator the app automatically swaps the loopback host for the machine
# serving the Metro bundle, keeping the port below. Set an explicit host or an
# https:// URL to opt out of that behaviour.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Firebase (Android FCM). google-services.json is the source of truth for the native SDK.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
