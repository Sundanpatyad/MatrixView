# Base URL of the DockX backend (REST + Socket.IO share this origin).
#
# In development you can leave this as localhost: on a physical device or
# emulator the app automatically swaps the loopback host for the machine
# serving the Metro bundle, keeping the port below. Set an explicit host or an
# https:// URL to opt out of that behaviour.
EXPO_PUBLIC_API_URL=http://localhost:4000
